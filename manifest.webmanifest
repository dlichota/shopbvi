{
  "id": "/",
  "name": "Larder Flow — Pantry Tracker",
  "short_name": "Larder Flow",
  "description": "Track pantry stock, surface low items, and check things off as you shop. Works offline.",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "portrait",
  "background_color": "#f7f6f2",
  "theme_color": "#01696f",
  "lang": "en",
  "dir": "ltr",
  "categories": ["food", "lifestyle", "productivity", "shopping"],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Shopping list",
      "short_name": "Shop",
      "description": "Items that need buying",
      "url": "/?view=shopping",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Inventory",
      "short_name": "Inventory",
      "description": "Everything in the larder",
      "url": "/?view=all",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Add an item",
      "short_name": "Add",
      "description": "Add a new pantry item",
      "url": "/?view=add",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
